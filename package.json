{
  "name": "fhir-matchbook",
  "version": "2.0.0",
  "initializrVersion": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "data": "node scripts/build-browsr.ts && node scripts/build-initializr.ts && node scripts/build-mappr.ts",
    "prebuild": "npm run data",
    "prestart": "npm run data",
    "snapshot": "node scripts/snapshot.ts",
    "resources": "node scripts/resources.ts",
    "og-image": "node scripts/og-image.ts",
    "vectors": "node scripts/mappr-vectors.ts",
    "initializr": "node cli/initializr.ts",
    "typecheck": "tsc -p tsconfig.node.json",
    "test:core": "node --test \"test/*.test.ts\"",
    "links": "node scripts/check-links.ts",
    "icons": "node scripts/icons.ts"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.3",
    "@huggingface/transformers": "4.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "bin": {
    "initializr": "cli/initializr.ts"
  }
}
